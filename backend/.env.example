# Local development example only. Leave the RCON target and secret empty until configured securely.
PANEL_DB_PATH=./data/panel.sqlite3
PANEL_PUBLIC_ORIGIN=http://127.0.0.1:8848
PANEL_SESSION_SECURE=false
# A persistent Fernet key is required before saving server settings through the panel.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PANEL_CONFIG_KEY=
# Both this deployment gate and a per-server opt-in are required for public HTTP RCON.
PANEL_ALLOW_PUBLIC_HTTP_RCON=false

# Wardogs RCON is a fixed, server-side target. Never expose this secret to the browser.
WARDOGS_RCON_ORIGIN=
WARDOGS_RCON_BEARER=
WARDOGS_RCON_CA_PATH=
WARDOGS_ALLOW_PRIVATE_HTTP=false
WARDOGS_ALLOW_PUBLIC_HTTP=false
WARDOGS_CONNECT_TIMEOUT=5
WARDOGS_READ_TIMEOUT=8
WARDOGS_MAX_RESPONSE_BYTES=1048576
WARDOGS_READ_RETRIES=1
