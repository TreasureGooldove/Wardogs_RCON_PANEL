    "/api/bot/bans": {
      "post": {
        "tags": [
          "QQ Bot"
        ],
        "summary": "Ban an online player with durable idempotency",
        "description": "Management token only. Online targets only. The request must carry a fresh targetRevision. Accepted first/replayed: 200. Rejected first/replayed: 409. Uncertain first: 502; uncertain replay: 409. Extra fields are forbidden. Same requestId and normalized body returns the stored receipt without executing again. Pending/interrupted receipts may omit updatedAt. A timeout is not proof of success; never retry under a new identifier.",
        "operationId": "ban_api_bot_bans_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BanRequest"
              },
              "example": {
                "steamId": "76561190000000001",
                "reason": "Example moderation reason",
                "targetRevision": "example-target-revision",
                "requestId": "bot-example-operation-0001",
                "operator": {
                  "qqId": "10000",
                  "groupId": "20000"
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanReceipt"
                },
                "example": {
                  "requestId": "bot-example-operation-0001",
                  "steamId": "76561190000000001",
                  "outcome": "accepted",
                  "code": "accepted",
                  "replayed": false,
                  "updatedAt": "2026-01-01T00:00:00Z"
                }
              }
            },
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              },
              "X-Request-ID": {
                "schema": {
                  "type": "string",
                  "description": "Trace identifier"
                }
              }
            }
          },
          "409": {
            "description": "Rejected receipt, unresolved replay, or generic requestId conflict",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/BanReceipt"
                    },
                    {
                      "$ref": "#/components/schemas/BotError"
                    }
                  ]
                }
              }
            }
          },
          "502": {
            "description": "Uncertain receipt; stop automatic retries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BanReceipt"
                }
              }
            }
          },
          "400": {
            "description": "Invalid bot request (custom handler; not default 422)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or disabled bot token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotError"
                }
              }
            }
          },
          "403": {
            "description": "Management identity required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotError"
                }
              }
            }
          },
          "429": {
            "description": "Per-role panel limit or upstream rate limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotError"
                }
              }
            }
          },
          "503": {
            "description": "Unconfigured target before durable claim",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BotError"
                }
              }
            }
          }
        },
        "security": [
          {
            "BotToken": []
          }
        ],
        "x-required-role": "management"
      }
