  "components": {
    "schemas": {
      "BanReceipt": {
        "properties": {
          "requestId": {
            "type": "string",
            "title": "Requestid"
          },
          "steamId": {
            "type": "string",
            "title": "Steamid"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "accepted",
              "rejected",
              "uncertain"
            ],
            "title": "Outcome"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "replayed": {
            "type": "boolean",
            "title": "Replayed"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updatedat"
          }
        },
        "type": "object",
        "required": [
          "requestId",
          "steamId",
          "outcome",
          "code",
          "replayed"
        ],
        "title": "BanReceipt"
      },
      "BanRequest": {
        "properties": {
          "steamId": {
            "type": "string",
            "pattern": "^[1-9][0-9]{16}$",
            "title": "Steamid"
          },
          "reason": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Reason",
            "description": "Nonblank printable text; no characters below U+0020 or U+007F. Leading/trailing whitespace is stripped."
          },
          "targetRevision": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Targetrevision"
          },
          "requestId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{8,128}$",
