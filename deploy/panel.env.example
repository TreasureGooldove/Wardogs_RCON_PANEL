# Copy to deploy/panel.env on your own host and restrict to the operator (0600).
# The browser origin must match the actual address, including its port.
# HTTPS: PANEL_SESSION_SECURE=true; HTTP: false. Omit to infer from the origin.
PANEL_PUBLIC_ORIGIN=https://panel.example.com
PANEL_SESSION_SECURE=true
# Generate once with Fernet.generate_key(); preserve the same value across rebuilds.
PANEL_CONFIG_KEY=
# Keep false unless the operator explicitly accepts sending the privileged Bearer over public HTTP.
PANEL_ALLOW_PUBLIC_HTTP_RCON=false

# Optional server-side key for Steam public avatar and persona lookup.
# Never put this value in frontend/.env or source control.
STEAM_WEB_API_KEY=

# Leave RCON unset until its fixed target and Bearer token are supplied securely.
WARDOGS_RCON_ORIGIN=
WARDOGS_RCON_BEARER=
WARDOGS_RCON_CA_PATH=
WARDOGS_ALLOW_PRIVATE_HTTP=false
WARDOGS_ALLOW_PUBLIC_HTTP=false
WARDOGS_CONNECT_TIMEOUT=5
WARDOGS_READ_TIMEOUT=8
WARDOGS_MAX_RESPONSE_BYTES=1048576
WARDOGS_READ_RETRIES=1
